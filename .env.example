# Copy to .env.local for local development. Never commit real values.

# --- GitHub (repository discovery) -------------------------------------------
# Required for live data: the account whose PUBLIC repositories are listed.
# Without it the site runs on the clearly labeled sample data in src/config/projects.ts.
GITHUB_USERNAME=

# Optional: raises the rate limit from 60 to 5,000 requests/hour. A fine-grained token
# with no extra permissions (public repositories, read-only) is enough. Server-side only.
GITHUB_TOKEN=

# --- Vercel (deployment metadata and production URLs) -----------------------
# Required for Vercel enrichment: a token with read access to your projects. Server-side only.
# Set it in the Vercel project's environment variables too, not only here, or deployed project
# channels get no launch link. Without it, links come only from manual `productionUrl` overrides
# and non-vercel.app GitHub "website" values.
VERCEL_TOKEN=

# Required when your projects are owned by a Vercel team (team_...). Leave empty for personal projects.
VERCEL_TEAM_ID=

# --- Site ---------------------------------------------------------------------
# Canonical public URL, used for metadata, Open Graph, and the sitemap.
# On Vercel this falls back to the project's production domain when empty.
NEXT_PUBLIC_SITE_URL=

# Optional: enables POST /api/revalidate (Authorization: Bearer <secret>). Minimum 16 characters.
REVALIDATE_SECRET=

# --- Contact form (email delivery through Resend) ------------------------------
# API key from https://resend.com/api-keys (sending access is enough). Server-side only.
# Without it, POST /api/contact answers "unavailable" and nothing is sent.
RESEND_API_KEY=

# Optional: where messages are delivered. Defaults to the email in src/config/profile.ts.
CONTACT_TO_EMAIL=

# Optional: the sender. Defaults to "Portfolio <onboarding@resend.dev>", which Resend only lets
# deliver to your own Resend account address. To send anywhere, verify a domain at
# https://resend.com/domains and use an address on it, e.g. "Portfolio <contact@your-domain.com>".
CONTACT_FROM_EMAIL=
